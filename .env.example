# FalkorDB connection (Render private service URL)
FALKORDB_HOST=falkordb-internal
FALKORDB_PORT=6379
FALKORDB_PASSWORD=your-secure-password-here

# Anthropic API key (shared with Engage backend)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# LLM model for entity extraction (Haiku for cost efficiency)
GRAPHITI_LLM_MODEL=claude-haiku-4-5-20251001

# OpenAI API key for embeddings (Graphiti default embedding provider)
OPENAI_API_KEY=sk-your-openai-key-here

# Service settings
PORT=8000
LOG_LEVEL=info

# P1 provenance rollout. These are the code defaults, restated so the intended
# shipping posture is explicit: the provenance chain lands inert. Do not change
# any of them without reading PROVENANCE_OPS.md first. Probe mode belongs only
# on a dedicated acceptance-probe process, never on the serving process.
GRAPHITI_PROVENANCE_MODE=legacy
GRAPHITI_STRUCTURED_V2_WRITE_MODE=off
GRAPHITI_ACCEPTANCE_PROBE_MODE=false

# Engage -> Graphiti request authentication. Roll out as optional first, deploy
# the matching Engage signer, then change both services to required.
GRAPHITI_AUTH_MODE=required
GRAPHITI_SEARCH_SECRET=replace-before-use-search-secret-with-random-32-plus-characters
GRAPHITI_INGEST_SECRET=replace-before-use-ingest-secret-with-random-32-plus-characters
GRAPHITI_ADMIN_SECRET=replace-before-use-admin-secret-with-random-32-plus-characters
GRAPHITI_AUTH_MAX_CLOCK_SKEW_SECONDS=300
